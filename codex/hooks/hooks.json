{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/claude/scripts/session-start.mjs\" --runtime=codex",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/claude/scripts/session-start.mjs\" --runtime=codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
